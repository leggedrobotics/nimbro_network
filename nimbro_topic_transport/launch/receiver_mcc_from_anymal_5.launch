<launch>
	<!--
	  This launch file runs a receiver node, which receives topics
	  over the network on port 17001 and publishes them on the local roscore.

	  See udp_sender.launch for the sender part.
	-->

	<node name="nimbro_missionctrl_anymal_5_receiver" pkg="nimbro_topic_transport" type="receiver" output="screen" launch-prefix="gdb -ex run --args">
		<!-- The port to receive packets on -->
		<param name="port" 					value="17202" />
		<param name="destination_port" 					value="17202" />
		<param name="topic_prefix" 	value="/anymal_5" />
	</node>
</launch>
