<launch>
	<!--
	  This launch file runs a receiver node, which receives topics
	  over the network on port 17001 and publishes them on the local roscore.

	  See udp_sender.launch for the sender part.
	-->
	<rosparam file="$(find alma_c)/config/nimbro/robot_settings.yaml" command="load" ns="" />

	<node name="nimbro_missionctrl_anymal_receiver" pkg="nimbro_topic_transport" type="receiver" output="screen" launch-prefix="gdb --args">
		<!-- The port to receive packets on -->
		<param name="port" 					value="17002" />
	</node>
</launch>
